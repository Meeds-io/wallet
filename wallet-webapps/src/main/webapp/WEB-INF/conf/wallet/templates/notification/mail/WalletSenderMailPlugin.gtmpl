<% String openURL = HASH == null ? BASE_URL : BASE_URL + "?hash=" + HASH; %>
<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("UINotification.title.EtherSenderNotificationPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.util.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;" >
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <table border="0" cellpadding="0" cellspacing="0" >
                                        <tr>
                                            <% if(AVATAR != null) { %>
                                              <!--[if mso]>
                                                <td width="64" valign="top">
                                                    <img width="44" height="44" style="margin-top: 2px; border-radius: <%= ACCOUNT_TYPE.equals("space") ? "8px" : "50%" %>;" src="$AVATAR" alt="" />
                                                </td>
                                              <![endif]-->
                                              <td width="64" valign="top" style="mso-hide:all; ">
                                                  <img width="44" height="44" style="margin-top: 2px; border-radius: <%= ACCOUNT_TYPE.equals("space") ? "8px" : "50%" %>;" src="$AVATAR" alt="" />
                                              </td>
                                            <% } %>
                                            <td  valign="top">
                                                <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto">
                                                  <%=io.meeds.portal.mail.util.EmailLayout.entityStyled(ACCOUNT_TYPE.equals("space") ? _ctx.appRes("Notification.message.SpaceEtherSenderNotificationPlugin", SENDER_URL, AMOUNT, RECEIVER_URL, SYMBOL) : _ctx.appRes("Notification.message.EtherSenderNotificationPlugin", AMOUNT, RECEIVER_URL, SYMBOL))%>
                                                </p>
                                                <% if(org.apache.commons.lang3.StringUtils.isNotBlank(MESSAGE)) { %>
                                                  <%=io.meeds.portal.mail.util.EmailLayout.quoteStart(false, _ctx.language)%><p style="margin:0; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}; white-space:pre-line;" dir="auto"><%=_ctx.escapeHTML(MESSAGE)%></p><%=io.meeds.portal.mail.util.EmailLayout.quoteEnd()%>
                                                <% } %>
                                                
                                            </td>
                                        </tr>
                                    </table>
<div dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                                    <%=io.meeds.portal.mail.util.EmailLayout.actionLink(_ctx.appRes("Notification.message.Open"), "$openURL", true)%>
                                                </div>
                                <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}">
                                        <%=io.meeds.portal.mail.util.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footer", FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>            
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
