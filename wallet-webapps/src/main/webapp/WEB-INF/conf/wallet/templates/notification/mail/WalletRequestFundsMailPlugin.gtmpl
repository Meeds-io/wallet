<% String acceptURL = FUNDS_ACCEPT_URL + "&id=" + NOTIFICATION_ID; %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height:20px;HelveticaNeue bold',arial,tahoma,serif;" class="mail-surface mail-text">
    <%
      _templateContext.put("header_title", _ctx.appRes("UINotification.title.FundsRequestNotificationPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; color:${palette.text};line-height:20px;" class="mail-surface mail-text">
                            <tr>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 10px 0;"  class="mail-surface">
                                    <table border="0" cellpadding="0" cellspacing="0" >
                                        <tr>
                                            <% if(AVATAR != null) { %>
                                              <td valign="top" width="90px" bgcolor="${palette.surface}" style="background: ${palette.surface};" class="mail-surface">
                                                  <img width="70px" height="70px" style="margin-top: 5px;border-radius: 4px;border: 1px solid ${palette.border};" class="mail-border" src="$AVATAR" />
                                              </td>
                                            <% } %>
                                            <td  valign="top">
                                                <p style="margin:0 0 12px; color: ${palette.text}; font-family:HelveticaNeue,arial,tahoma,serif; font-size:13px; line-height: 20px;" class="mail-text">
                                                  <%= ACCOUNT_TYPE.equals("space") ? 
                                                       _ctx.appRes("Notification.message.SpaceFundsRequestNotificationPlugin", USER_URL, AMOUNT, SYMBOL, SENDER_URL)
                                                       : _ctx.appRes("Notification.message.FundsRequestNotificationPlugin", USER_URL, AMOUNT, SYMBOL)%>
                                                </p>
                                                <% if (org.apache.commons.lang3.StringUtils.isNotBlank(MESSAGE)) { %>
                                                <blockquote>
                                                  <p style="margin:0 0 12px; color: ${palette.text}; font-family:HelveticaNeue,arial,tahoma,serif; font-size:13px; line-height: 20px;white-space: pre-line;"
                                                     class="mail-text"><%= MESSAGE %></p>
                                                </blockquote>
                                                <% } %>
                                                <div>
                                                    <a target="_blank" style="
                                                        display: inline-block;
                                                        text-decoration: none;
                                                        font-size: 11px;
                                                        font-family:HelveticaNeue,arial,tahoma,serif;
                                                        color: #ffffff;
                                                        text-shadow: 0 -1px 0 rgba(23, 33, 37, .25);
                                                        background-color: ${palette.primary};
                                                        background-repeat: repeat-x;
                                                        border-radius: 4px;
                                                        -moz-border-radius: 4px;
                                                        padding: 5px 8px;
                                                        line-height: 100%;
                                                        text-align: center;
                                                        border: 1px solid ${palette.primary};
                                                        font-weight: bold;
                                                        -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                        -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                        box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                        vertical-align: middle;
                                                    " href="$acceptURL" target="_blank"><%=_ctx.appRes("Notification.message.FundsRequestAccpt")%></a>
                                                </div>
                                            </td>
                                          </tr><!--end header area-->
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>            
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
